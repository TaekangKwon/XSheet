{
  "name": "xsheet",
  "version": "0.3.0",
  "private": true,
  "license": "UNLICENSED",
  "description": ".xlsx を Excel どおりに表示する JavaScript ライブラリ（読み取り専用）",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./internal": {
      "types": "./dist/core/internal.d.ts",
      "import": "./dist/core/internal.js"
    },
    "./geom": {
      "types": "./dist/geom/index.d.ts",
      "import": "./dist/geom/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "build": "vite build && tsc -p tsconfig.build.json && node tools/standalone/build.mjs",
    "check:consumer": "node tools/consumer-check.mjs",
    "check:standalone": "node tools/standalone/check.mjs",
    "size": "node tools/size.mjs",
    "release:zip": "node tools/release-zip.mjs",
    "sync:status": "node tools/sync/sync.mjs status",
    "sync:patch": "node tools/sync/sync.mjs patch",
    "geom:build": "node tools/geom/build-preset-geom.mjs",
    "geom:compare": "node fixtures/excel/compare-ref-geoms.mjs",
    "examples": "vite --config examples/vite.config.ts",
    "examples:static": "vite preview --outDir . --host localhost --port 5174 --strictPort"
  },
  "dependencies": {
    "jszip": "3.10.2",
    "ssf": "0.11.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
