{
  "name": "xsheet",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": ".xlsx を Excel どおりに表示する JavaScript ライブラリ（読み取り専用）",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./geom": {
      "types": "./dist/geom/index.d.ts",
      "import": "./dist/geom/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "jszip": "3.10.2",
    "ssf": "0.11.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
