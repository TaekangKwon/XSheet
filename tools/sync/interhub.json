  "manual": [
    {
      "path": "src/lib/viewers/spreadsheet.ts",
      "dest": [
        "src/render/grid-table.ts",
        "src/render/sheet-view.ts",
        "src/render/render-sheet.ts",
        "src/render/sheet-tabs.ts",
        "src/render/render-workbook.ts"
      ],
      "note": ".xlsx の部分だけを分けて写した（03 §3 M2-3・M2-4）。.xls の経路・fitTableBodyToWindow・バナーとツールバーは写さない"
    },
    {
      "path": "src/lib/viewers/spreadsheet.*.render.test.ts",
      "dest": ["tests/render/render-sheet.*.test.ts", "tests/render/render-workbook*.test.ts"],
      "note": "renderSheet・renderWorkbook を呼ぶ形に書き直した（03 §3 M2-3）"
    },
    {
      "path": "src/styles/global.css",
      "dest": ["src/style.css"],
      "note": ".ih-spreadsheet・.ih-xlsx-* の規則だけを xs- にして写した（03 §3 M3-1）。テーマのブロックは写さない"
    },
    {
      "path": "src/locales/*.ts",
      "dest": ["src/render/messages.ts"],
      "note": "spreadsheet.*・data.noData のキーだけを MESSAGES_JA・MESSAGES_EN の既定値にした（03 §3）"
    },
    {
      "path": "tools/geom/NOTICE",
      "dest": ["NOTICE"],
      "note": "冒頭の日本語の説明だけを直した。Ecma の著作権表示の本文は変えない（03 §2）"
    }
  ],
