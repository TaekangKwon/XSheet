  "patterns": [
    {
      "from": "src/lib/xlsx/__fixtures__/excel/*",
      "to": "fixtures/excel/*",
      "note": "照合の fixtures（05_quality.md §2）"
    },
    {
      "from": "src/lib/xlsx/*.test.ts",
      "to": "tests/core/*.test.ts"
    },
    {
      "from": "src/lib/xlsx/make-*.ts",
