    },
    {
      "from": "src/lib/viewers/xlsx-chart-ref2-checks.ts",
      "to": "tests/render/chart-ref2-checks.ts",
      "note": "テストだけが使う部品"
    },
    {
      "from": "src/lib/viewers/xlsx-*.ts",
      "to": "src/render/*.ts",
      "note": "render の中はすべて xlsx の描画なので、ファイル名から xlsx- を外す（03 §3 M2-1）"
    },
    {
      "from": "tools/geom/*",
      "to": "tools/geom/*"
    }
  ],
  "imports": {
    "$comment": "相対の import（from・import()・vi.mock()・new URL()）は、元のファイルと指す先の両方を対応表で引いて、行き先どうしの相対パスに書き直す。書き直した後の指定に overrides を順にかける",
    "overrides": [
      {
        "scope": ["src/render/**"],
        "find": "^\\.\\./core/types$",
        "replace": "../core/index",
        "note": "render は core を ../core/index か ../core/internal からだけ引く（eslint.config.js）"
      },
      {
        "scope": ["src/render/**"],
        "find": "^\\.\\./core/(?!index$|internal$)[^/]+$",
        "replace": "../core/internal",
        "warn": "core/internal から出しているか確かめる（render は core の中の作りに直接つながない）"
      }
    ]
  },
  "transforms": [
    {
      "id": "prefix-data-attr",
      "scope": ["src/**", "tests/**"],
      "find": "data-ih-xlsx-fmt",
      "replace": "data-xs-fmt"
    },
    {
      "id": "prefix-css-var",
      "scope": ["src/**", "tests/**"],
      "find": "--ih-(?:xlsx-)?(?=[a-z])",
      "replace": "--xs-"
    },
    {
      "id": "prefix-xlsx-class",
      "scope": ["src/**", "tests/**"],
      "find": "(?<![\\w-])ih-xlsx-(?=[a-z])",
      "replace": "xs-"
    },
    {
      "id": "prefix-xf-class",
      "scope": ["src/**", "tests/**"],
      "find": "(?<![\\w-])ih-xf-",
      "replace": "xs-xf-"
    },
    {
      "id": "prefix-sheet-root",
      "scope": ["src/**", "tests/**"],
      "find": "(?<![\\w-])ih-spreadsheet(?![\\w-])",
      "replace": "xs-sheet"
    },
    {
      "id": "prefix-shared-parts",
      "scope": ["src/**", "tests/**"],
      "find": "(?<![\\w-])ih-(?:dv-(rownum|empty)|(sheet-(?:tabs|nav|strip)))(?![\\w-])",
      "replace": "xs-$1$2"
    },
    {
      "id": "source-comment",
      "scope": ["src/**", "tests/**"],
      "find": "^(\\s*(?://|\\*)\\s*正: )docs/",
      "replace": "$1InterHub docs/"
    }
  ],
  "leftovers": [
    {
      "scope": ["src/**", "tests/**"],
      "find": "(?<![\\w-])ih-[a-z]",
      "note": "InterHub の接頭辞が残った（ih-toggle・ih-toolbar・ih-data-* などは場所ごとに名前が違うので手で直す）"
    },
    {
      "scope": ["src/**"],
      "find": "\\bt\\(\\s*['\"]",
      "note": "InterHub の文言関数 t() が残った（messages に替える）"
    }
  ],
  "manualTransforms": [
    {
      "id": "messages",
      "note": "文言：InterHub の t('spreadsheet.*') は RenderOptions.messages（src/render/messages.ts の MESSAGES_JA・MESSAGES_EN）に替える。キーを messages.ts に足す（03 §4 の 2）"
    },
    {
      "id": "module-state",
      "note": "モジュール変数の状態（renderGeneration・disposeXlsxView など）は表示のインスタンスへ（03 §4 の 4）"
    },
    {
      "id": "shared-parts",
      "note": "InterHub の共用の部品とクラス（ih-toggle・ih-toolbar・ih-data-view・ih-data-body・ih-data-banner・fitTableBodyToWindow）は、render に要るものだけ xs- で作り直してある（03 §3 M2-3・M2-4・§4 の 5）"
    },
    {
      "id": "geom-layer",
      "note": "geom：render は geom を型だけ静的に引き、形の表は shapes.ts の loadGeom で動的 import する（03 §3 M2-3）。core の drawing-geom.ts・limits.ts は ../geom/defs から引く（03 §1 M1-2）"
    },
    {
      "id": "core-entry",
      "note": "新しい公開の型・関数は src/core/index.ts から出すか決める（02_architecture.md §2）。render が使う中の関数は src/core/internal.ts から出す"
    },
    {
      "id": "prettier",
      "note": "InterHub のコードは Prettier で整っていない。新しく写したファイルは 1 ファイルずつ npx prettier --write <ファイル> で整える（リポジトリ全体への --write はしない）"
    },
    {
      "id": "xsheet-marks",
      "note": "XSheet 固有の直しは別のファイルに置くか、写したファイルの中では // XSheet: の印を付けて 1 か所にまとめる（ADR-0003 §4-1 の 3）"
    }
  ]
}
