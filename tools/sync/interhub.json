    {
      "path": "src/lib/viewers/table-fit.ts",
      "reason": "枠の高さは使う側の仕事（03 §4 の 5）"
    },
    {
      "path": "src/lib/viewers/data.ts",
      "reason": ".xlsx 以外の表示"
    },
    {
      "path": "src/lib/viewers/docx.ts",
      "reason": ".xlsx 以外の表示"
    },
    {
